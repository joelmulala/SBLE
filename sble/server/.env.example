# SBLE API — environment template (copy to `.env` and adjust)

PORT=5000
CLIENT_URL=http://localhost:3000

DB_DIALECT=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sble
DB_USER=postgres
DB_PASSWORD=
DB_SSL=false

JWT_SECRET=
ENCRYPTION_KEY=

KEYCLOAK_REALM=sble
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_CLIENT_ID=sble-client

REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=

# Optional — LiveKit Cloud or self-hosted (Phase 2+ classroom RTC).
# When unset, POST /api/rooms/:roomToken/livekit-token returns 503.
# Use the WebSocket URL from the LiveKit dashboard (wss://…). Do not use LIVEKIT_URL alone.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_WS_URL=
