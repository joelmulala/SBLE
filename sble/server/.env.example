# SBLE API — local development (non-Docker)
# Copy to server/.env

NODE_ENV=development

DB_DIALECT=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sble
DB_USER=postgres
DB_PASSWORD=

JWT_SECRET=change_this_jwt_secret_min_32_chars
ENCRYPTION_KEY=exactly_32_characters_here!

CLIENT_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Email (Brevo SMTP — required for password reset emails)
EMAIL_ENABLED=true
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-brevo-smtp-login
SMTP_PASS=your-brevo-smtp-key
MAIL_FROM_NAME=SBLE
MAIL_FROM_ADDRESS=no-reply@your-verified-domain.com

# Password reset (optional)
PASSWORD_RESET_EXPIRY_MINUTES=30
PASSWORD_RESET_RATE_LIMIT_MAX=5
PASSWORD_RESET_RATE_LIMIT_WINDOW_MS=3600000

ALLOW_DEV_LOGIN=true
TEMP_ADMIN_PASSWORD=admin123
TEMP_LECTURER_PASSWORD=lecturer123
TEMP_STUDENT_PASSWORD=student123

LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_WS_URL=

PERFORMANCE_SERVICE_URL=http://localhost:8000/analyze-performance

UPLOAD_DIR=./uploads
