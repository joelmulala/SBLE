{
  "realm": "sble",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "roles": {
    "realm": [
      { "name": "student", "description": "Enrolled student" },
      { "name": "lecturer", "description": "Course lecturer" },
      { "name": "admin", "description": "Platform administrator" }
    ]
  },
  "clients": [
    {
      "clientId": "sble-client",
      "enabled": true,
      "publicClient": true,
      "redirectUris": ["https://yourdomain.com/*", "http://localhost:3000/*"],
      "webOrigins": ["https://yourdomain.com", "http://localhost:3000"],
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false
    }
  ],
  "passwordPolicy": "length(8) and upperCase(1) and digits(1) and specialChars(1)"
}
