# SBLE Docker / production — copy to .env and change secrets before deploy
# Generate secrets: openssl rand -hex 32

# --- Public URL (browser) ---
HTTP_PORT=8080
CLIENT_URL=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:8080

# --- PostgreSQL (compose service: postgres) ---
DB_DIALECT=postgres
DB_HOST=postgres
DB_PORT=5432
DB_NAME=sble
DB_USER=sble
DB_PASSWORD=change_this_postgres_password

# --- API secrets (required) ---
JWT_SECRET=change_this_jwt_secret_min_32_chars
ENCRYPTION_KEY=exactly_32_characters_here!

# --- Demo / dev login (disabled in production unless ALLOW_DEV_LOGIN=true) ---
ALLOW_DEV_LOGIN=true
TEMP_ADMIN_PASSWORD=admin123
TEMP_LECTURER_PASSWORD=lecturer123
TEMP_STUDENT_PASSWORD=student123

# --- LiveKit (required for live classes) ---
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_WS_URL=

# --- Optional: Redis sessions ---
# REDIS_HOST=redis
# REDIS_PORT=6379

# --- Optional: SMTP ---
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# --- Optional: MinIO object storage ---
# MINIO_ENDPOINT=
# MINIO_PORT=9000
# MINIO_ACCESS_KEY=
# MINIO_SECRET_KEY=
# MINIO_BUCKET=sble-uploads

# --- Optional: performance analytics (enable compose profile: analytics) ---
# docker compose --profile analytics up --build
PERFORMANCE_SERVICE_URL=http://performance:8000/analyze-performance

# --- Optional: legacy peer WebRTC signaling ---
# ENABLE_LEGACY_WEBRTC=false

# --- Production hardening ---
NODE_ENV=production
# ENABLE_ADMIN_DEBUG=false
